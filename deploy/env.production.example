# RR-CMS — PRODUCTION environment.
#
#   cp deploy/env.production.example /opt/rrcms/.env
#   chown rrcms:rrcms /opt/rrcms/.env && chmod 600 /opt/rrcms/.env
#
# Every line marked <-- SET must be changed before the service is started.
# Nothing here may be copied from a development machine.

NODE_ENV=production
PORT=3100

# --- database ---------------------------------------------------------------
# A user with rights on `rrcms` ONLY, so nothing here can reach bbtro or crtms
# even by mistake. DROP is deliberately NOT granted in production: npm run
# db:reset must not be able to run against a live database.
#
#   CREATE DATABASE rrcms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'rrcms_app'@'localhost' IDENTIFIED BY '<strong password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES
#     ON rrcms.* TO 'rrcms_app'@'localhost';
#   GRANT SELECT ON bbtro.v_rr_crew_lookup   TO 'rrcms_app'@'localhost';
#   GRANT SELECT ON bbtro.v_rr_crew_contact  TO 'rrcms_app'@'localhost';
#   GRANT SELECT ON bbtro.v_rr_train_lookup  TO 'rrcms_app'@'localhost';
#   FLUSH PRIVILEGES;
#
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rrcms
DB_USER=rrcms_app
DB_PASSWORD=                      # <-- SET

# --- sessions ---------------------------------------------------------------
# Generate it; do not invent it. A session signed with a guessable secret can
# be forged, and the development secret is on more than one machine.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
SESSION_SECRET=                   # <-- SET, 32 characters or more
SESSION_HOURS=12

# --- the crew feedback QR posters -------------------------------------------
# Printed onto every poster at every running room. If this is blank or points
# at localhost when the posters are printed, every poster is dead paper and no
# feedback ever arrives. Set it BEFORE anything is printed.
PUBLIC_BASE_URL=                  # <-- SET, e.g. https://rrcms.example.railnet.gov.in

# --- uploads ----------------------------------------------------------------
# Only file metadata goes in the database; the files live here. This directory
# MUST be in the same backup as the database dump — a restore of one without
# the other produces records pointing at documents that are not there.
UPLOAD_DIR=/var/lib/rrcms/uploads

# --- mounting inside CRTMS (leave blank when standing alone) -----------------
# APP_BASE_PATH=/rrcms
