# Nightly database dump — see deploy/mysql-backup.sh
# Installed at /etc/cron.d/mysql-backup, owned by root, mode 644.
#
# 01:40 rather than midnight: nothing else on this server runs then, and it is
# well clear of certbot's renewal window and of the running rooms' night shift,
# which is when the crew actually uses the applications.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""
40 1 * * * root /usr/local/sbin/mysql-backup.sh
