# RR-CMS — local development
# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=3100

# Dedicated database and user. This user must have rights to the rrcms schema
# ONLY, so that nothing here can reach bbtro or crtms even by mistake:
#
#   CREATE DATABASE rrcms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'rrcms_app'@'localhost' IDENTIFIED BY '<strong-password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES
#     ON rrcms.* TO 'rrcms_app'@'localhost';
#   FLUSH PRIVILEGES;
#
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rrcms
DB_USER=rrcms_app
DB_PASSWORD=

SESSION_SECRET=
# Printed on the crew feedback QR posters. Must be an address a phone can reach —
# not localhost — before printing for a live running room.
PUBLIC_BASE_URL=

UPLOAD_DIR=./storage/uploads
