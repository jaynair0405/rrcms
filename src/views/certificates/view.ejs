<div class="row" style="margin-bottom:14px;align-items:center">
  <a class="btn ghost small" href="<%= url('/certificates') %>?month=<%= month %>">← All running rooms</a>
  <div class="spacer"></div>
  <% if (cert) { %>
    <a class="btn ghost small" style="margin-right:8px" href="<%= url('/certificates/' + rr.id + '/' + month.slice(0,7)) %>?print=1">Printable version</a>
  <% } %>
  <% if (can('bill.prepare') && (!cert || cert.status === 'draft' || cert.status === 'returned')) { %>
    <form method="post" action="<%= url('/certificates/generate') %>" style="margin:0">
      <input type="hidden" name="rr" value="<%= rr.id %>">
      <input type="hidden" name="month" value="<%= month %>">
      <button class="btn" type="submit"><%= cert ? 'Regenerate from current records' : 'Generate certificate' %></button>
    </form>
  <% } %>
</div>

<%- await include('_pack') %>

<% if (cert) { %>
<div class="grid" style="grid-template-columns:1fr 1fr;margin-top:14px">
  <div class="card">
    <div class="card-h"><h3>Certify</h3><span class="sub">RR In-charge</span></div>
    <div class="card-b">
      <% if (cert.status === 'certified' || cert.status === 'countersigned') { %>
        <div class="st good"><span class="dot"></span>Certified on <%= String(cert.certified_at).slice(0,16).replace('T',' ') %></div>
      <% } else if (can('bill.prepare')) { %>
        <form method="post" action="<%= url('/certificates/' + rr.id + '/' + month.slice(0,7) + '/certify') %>">
          <div style="margin-bottom:10px"><label class="fl">Remarks (optional)</label>
            <input class="fi" type="text" name="remarks" placeholder="anything the divisional officer should know"></div>
          <button class="btn" type="submit">Certify this pack</button>
        </form>
        <div class="muted" style="font-size:11.5px;margin-top:8px">
          Certifying freezes the sheet. After this it can only be counter-signed or returned.
        </div>
      <% } else { %>
        <div class="muted" style="font-size:12.5px">Awaiting the RR In-charge.</div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-h"><h3>Counter-sign</h3><span class="sub">Sr. DEE (TRO) / DME (O&amp;C)</span></div>
    <div class="card-b">
      <% if (cert.status === 'countersigned') { %>
        <div class="st good"><span class="dot"></span>Counter-signed on <%= String(cert.countersigned_at).slice(0,16).replace('T',' ') %></div>
      <% } else if (!can('bill.pass')) { %>
        <div class="muted" style="font-size:12.5px">Your role does not counter-sign certificates.</div>
      <% } else if (cert.status !== 'certified') { %>
        <div class="muted" style="font-size:12.5px">The RR In-charge has to certify the pack first.</div>
      <% } else { %>
        <form method="post" action="<%= url('/certificates/' + rr.id + '/' + month.slice(0,7) + '/countersign') %>"
              style="margin-bottom:12px">
          <button class="btn" type="submit">Counter-sign</button>
        </form>
        <div class="hr"></div>
        <form method="post" action="<%= url('/certificates/' + rr.id + '/' + month.slice(0,7) + '/return') %>">
          <div style="margin-bottom:10px"><label class="fl">Return to the running room, because</label>
            <input class="fi" type="text" name="returned_reason" placeholder="a reason is required"></div>
          <button class="btn ghost" type="submit">Return for correction</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
<% } %>
