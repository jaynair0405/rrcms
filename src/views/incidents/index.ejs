<%
/* The security and incident register. Audit item P14, first half.

   Most of what is recorded here carries NO penalty, and the page says so
   plainly. A fire or a theft is an event the Railway must know about, not a
   deficiency. The one exception is clause A3 — and only where the man was the
   contractor's. A driver found intoxicated is a crew discipline matter, and the
   screen refuses to offer the clause in that case rather than trusting whoever
   is reading it to know the difference. */
const canRecord = can('incident.record');
const d = v => v ? String(v).slice(0, 10) : '';
const t = v => v ? String(v).slice(0, 5) : '';
const TYPE = Object.fromEntries(types);
const INV = Object.fromEntries(involves);
const ST = { open: ['crit', 'Open'], under_enquiry: ['warn', 'Under enquiry'], closed: ['good', 'Closed'] };
%>

<% if (note) { %>
  <div class="note <%= note === 'closed' ? 'ok' : (note === 'a3' ? 'err' : '') %>" style="margin-bottom:14px">
    <% if (note === 'recorded') { %><b>The incident has been recorded.</b>
      It stays open until the Railway closes it or puts it under enquiry.
    <% } else if (note === 'closed') { %><b>The incident has been closed</b>, with what was found on the record.
    <% } else if (note === 'under_enquiry') { %><b>The incident is now under enquiry.</b>
    <% } else if (note === 'open') { %><b>The incident has been reopened.</b>
    <% } else if (note === 'a3') { %><b>Clause A3 has been raised on the deficiency register</b> —
      Rs 1,000 per labour per case, contractor labour found intoxicated. It can be corrected or withdrawn
      there like any other. <a href="<%= url('/deficiencies') %>">Open the deficiency register</a>.
    <% } %>
  </div>
<% } %>

<div class="kpis" style="margin-bottom:14px">
  <div class="kpi"><i class="strip" style="background:var(--s1)"></i>
    <div class="lab">On the register</div><div class="val"><%= counts.total || 0 %></div>
    <div class="foot">across the rooms you hold</div></div>
  <div class="kpi"><i class="strip" style="background:var(--critical)"></i>
    <div class="lab">Still open</div><div class="val"><%= counts.open || 0 %></div>
    <div class="foot">nothing recorded as done about them yet</div></div>
  <div class="kpi"><i class="strip" style="background:var(--warning)"></i>
    <div class="lab">Under enquiry</div><div class="val"><%= counts.enquiry || 0 %></div>
    <div class="foot">being looked into</div></div>
  <div class="kpi"><i class="strip" style="background:var(--warning)"></i>
    <div class="lab">Railway never told</div><div class="val"><%= counts.unreported || 0 %></div>
    <div class="foot">no date on record for the report</div></div>
</div>

<% if (canRecord) { %>
<div class="card" style="margin-bottom:14px">
  <div class="card-h"><h3>Record an incident</h3>
    <span class="sub">fire, theft, miscreant activity, accident, death, intoxication</span></div>
  <div class="card-b">
    <form method="post" action="<%= url('/incidents') %>" enctype="multipart/form-data">
      <div class="row" style="gap:10px;margin-bottom:10px">
        <div style="flex:1.3"><label class="fl">Running room</label>
          <select class="fi" name="rr" required>
            <% rooms.forEach(function(r){ %>
              <option value="<%= r.id %>" <%= String(r.id) === String(rr) ? 'selected' : '' %>><%= r.name %> (<%= r.div_code %>)</option>
            <% }); %>
          </select></div>
        <div style="flex:0 0 150px"><label class="fl">Happened on</label>
          <input class="fi" type="date" name="occurred_on" required max="<%= today %>" value="<%= today %>"></div>
        <div style="flex:0 0 110px"><label class="fl">At</label>
          <input class="fi" type="time" name="occurred_at"></div>
        <div style="flex:0 0 150px"><label class="fl">Railway told on</label>
          <input class="fi" type="date" name="reported_on" max="<%= today %>"></div>
      </div>

      <div class="row" style="gap:10px;margin-bottom:10px">
        <div style="flex:1"><label class="fl">What kind</label>
          <select class="fi" name="incident_type" required id="itype">
            <option value="">— choose —</option>
            <% types.forEach(function(x){ %><option value="<%= x[0] %>"><%= x[1] %></option><% }); %>
          </select></div>
        <div style="flex:1.2"><label class="fl">Who was at the centre of it</label>
          <select class="fi" name="involves" id="inv">
            <% involves.forEach(function(x){ %>
              <option value="<%= x[0] %>" <%= x[0]==='nobody'?'selected':'' %>><%= x[1] %></option><% }); %>
          </select></div>
        <div style="flex:0 0 140px"><label class="fl">How serious</label>
          <select class="fi" name="severity">
            <option value="">— not stated —</option>
            <% severity.forEach(function(x){ %><option value="<%= x[0] %>"><%= x[1] %></option><% }); %>
          </select></div>
      </div>

      <div style="margin-bottom:10px">
        <label class="fl">In one line, what happened</label>
        <input class="fi" name="summary" required maxlength="300"
               placeholder="Kitchen chimney caught fire during the evening meal; put out with the extinguisher">
      </div>
      <div class="row" style="gap:10px;margin-bottom:10px">
        <div style="flex:1"><label class="fl">Who was affected</label>
          <input class="fi" name="persons_affected" maxlength="400"
                 placeholder="names, or how many people"></div>
        <div style="flex:1.3"><label class="fl">What was done at once</label>
          <input class="fi" name="immediate_action" maxlength="600"></div>
      </div>
      <div style="margin-bottom:10px">
        <label class="fl">The full account</label>
        <textarea class="fi" name="detail" rows="3" maxlength="4000"
                  placeholder="Written while it is fresh. An enquiry six months later reads this, not somebody's memory."></textarea>
      </div>

      <div class="hr"></div>
      <div style="font-size:13px;font-weight:600;margin-bottom:4px">Who was told</div>
      <div class="muted" style="font-size:11.5px;margin-bottom:8px">
        The question at an enquiry is never <i>was the police informed</i> — it is <b>when, and under what
        number</b>. Leave a row blank if that authority was not involved.
      </div>
      <div class="tblwrap"><table class="tbl">
        <thead><tr><th style="width:24%">Authority</th><th style="width:150px">Told on</th>
          <th style="width:110px">At</th><th>Reference</th></tr></thead>
        <tbody>
        <% authorities.forEach(function(a){ %>
          <tr>
            <td><b><%= a[1] %></b></td>
            <td><input class="fi" type="date" name="n_<%= a[0] %>_on" max="<%= today %>" style="width:140px"></td>
            <td><input class="fi" type="time" name="n_<%= a[0] %>_at" style="width:104px"></td>
            <td><input class="fi" name="n_<%= a[0] %>_ref" maxlength="80" style="width:100%"
                       placeholder="<%= a[2] %>"></td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>

      <div class="row" style="gap:10px;margin:10px 0">
        <div style="flex:1"><label class="fl">A photograph or report</label>
          <input class="fi" type="file" name="evidence" accept="image/*,application/pdf">
          <div class="muted" style="font-size:11px;margin-top:3px"><%= accepted %></div></div>
      </div>

      <div class="note" style="margin-bottom:12px">
        <b>Almost nothing here is a penalty.</b> A fire, a theft or an accident is an event the Railway must
        know about, and this register raises nothing against the contractor for it. The one exception is
        <b>clause A3</b> — Rs 1,000 per labour per case where <b>the contractor's own man</b> is found
        intoxicated, offered on the entry once it is saved. <b>Intoxication of running staff is a different
        matter entirely</b>: a crew discipline question for the lobby and the controller, and no contractor
        penalty follows from it. That is why the register asks whose man it was.
      </div>

      <button class="btn" type="submit">Record it</button>
    </form>
  </div>
</div>
<% } %>

<form class="row" method="get" style="margin-bottom:14px;align-items:flex-end">
  <div style="flex:0 0 230px"><label class="fl">Running room</label>
    <select class="fi" name="rr" onchange="this.form.submit()">
      <option value="">All within your access</option>
      <% rooms.forEach(function(r){ %>
        <option value="<%= r.id %>" <%= String(r.id)===String(rr)?'selected':'' %>><%= r.name %></option>
      <% }); %>
    </select></div>
  <div style="flex:0 0 170px"><label class="fl">State</label>
    <select class="fi" name="status" onchange="this.form.submit()">
      <option value="">Any</option>
      <% statuses.forEach(function(x){ %>
        <option value="<%= x[0] %>" <%= x[0]===status?'selected':'' %>><%= x[1] %></option><% }); %>
    </select></div>
  <div style="flex:0 0 190px"><label class="fl">Kind</label>
    <select class="fi" name="type" onchange="this.form.submit()">
      <option value="">Any</option>
      <% types.forEach(function(x){ %>
        <option value="<%= x[0] %>" <%= x[0]===type?'selected':'' %>><%= x[1] %></option><% }); %>
    </select></div>
  <noscript><button class="btn" type="submit">Filter</button></noscript>
</form>

<div class="card">
  <div class="card-h"><h3>The register</h3>
    <span class="sub"><%= rows.length %> entr<%= rows.length === 1 ? 'y' : 'ies' %></span></div>
  <div class="tblwrap"><table class="tbl">
    <thead><tr>
      <th style="width:110px">When</th><th style="width:130px">Running room</th>
      <th style="width:130px">Kind</th><th>What happened</th>
      <th style="width:120px">Told</th><th style="width:200px">State</th>
    </tr></thead>
    <tbody>
    <% rows.forEach(function(i){ %>
      <tr id="i<%= i.id %>">
        <td class="tnum"><%= d(i.occurred_on) %>
          <% if (i.occurred_at) { %><div class="muted" style="font-size:11px"><%= t(i.occurred_at) %></div><% } %></td>
        <td><%= i.rr_name %><div class="muted" style="font-size:10.5px"><%= i.div_code %></div></td>
        <td><span class="pill <%= i.status==='open'?'r':'' %>"><%= TYPE[i.incident_type] || i.incident_type %></span>
          <% if (i.severity) { %><div class="muted" style="font-size:10.5px"><%= i.severity %></div><% } %></td>
        <td style="font-size:12.2px"><%= i.summary %>
          <div class="muted" style="font-size:11px">
            <%= INV[i.involves] || i.involves %><% if (i.staff_name) { %> · <%= i.staff_name %><% } %>
            <% if (i.persons_affected) { %> · <%= i.persons_affected %><% } %>
          </div>
          <% if (i.immediate_action) { %>
            <div class="muted" style="font-size:11px">Done at once: <%= i.immediate_action %></div><% } %>
          <% if (i.evidence_file_id) { %>
            <div style="font-size:11px"><a href="<%= url('/photo/' + i.evidence_file_id) %>" target="_blank">evidence on record</a></div>
          <% } %>
          <% if (i.closure_remarks) { %>
            <div class="muted" style="font-size:11px;margin-top:3px">Found: <%= i.closure_remarks %></div><% } %>
        </td>
        <td>
          <% if (!i.reported_on) { %>
            <span class="st warn"><span class="dot"></span>not reported</span>
          <% } else if (i.told_after > 0) { %>
            <span class="st warn"><span class="dot"></span><%= i.told_after %> day<%= i.told_after===1?'':'s' %> later</span>
          <% } else { %>
            <span class="st good"><span class="dot"></span>same day</span>
          <% } %>
          <div class="muted" style="font-size:10.5px"><%= i.told %> authorit<%= i.told===1?'y':'ies' %></div>
        </td>
        <td>
          <span class="st <%= ST[i.status][0] %>"><span class="dot"></span><%= ST[i.status][1] %></span>
          <% if (i.status === 'closed' && i.closed_name) { %>
            <div class="muted" style="font-size:10.5px">by <%= i.closed_name %>, <%= d(i.closed_on) %></div><% } %>

          <% if (can('incident.close')) { %>
            <form method="post" action="<%= url('/incidents/' + i.id + '/status') %>" style="margin-top:6px">
              <div class="row" style="gap:5px;align-items:flex-end">
                <select class="fi" name="status" style="width:118px;font-size:11.5px">
                  <% statuses.forEach(function(x){ %>
                    <option value="<%= x[0] %>" <%= x[0]===i.status?'selected':'' %>><%= x[1] %></option><% }); %>
                </select>
                <button class="btn ghost small" type="submit">Set</button>
              </div>
              <input class="fi" name="closure_remarks" maxlength="600" style="margin-top:4px;font-size:11.5px"
                     placeholder="what was found" value="<%= i.closure_remarks || '' %>">
            </form>
          <% } %>

          <% if (i.a3 && can('deficiency.record')) { %>
            <form method="post" action="<%= url('/incidents/' + i.id + '/a3') %>" style="margin-top:6px">
              <button class="btn ghost small" type="submit">Raise clause A3</button>
            </form>
          <% } else if (i.incident_type === 'intoxication' && i.involves === 'running_staff') { %>
            <div class="muted" style="font-size:10.5px;margin-top:6px">
              Running staff — a crew discipline matter. No contractor penalty arises.
            </div>
          <% } %>
        </td>
      </tr>
    <% }); %>
    <% if (!rows.length) { %>
      <tr><td colspan="6" class="muted">Nothing on the register for this filter.</td></tr>
    <% } %>
    </tbody>
  </table></div>
  <div class="tblfoot">
    An empty register because nothing happened and an empty register because nobody wrote anything down look
    exactly alike. <b>Railway told</b> is the column an enquiry reads first: the gap between the event and the
    report is the finding, and <i>not reported</i> is not the same as <i>nothing to report</i>.
    Closing an entry needs a line saying what was found — a bare "closed" answers nothing.
  </div>
</div>
