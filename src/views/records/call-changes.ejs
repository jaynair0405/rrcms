<%- await include('_nav') %>
<%- await include('_cbtabs') %>

<% if (note === 'withdrawn') { %><div class="note warn" style="margin-bottom:14px">The call has been marked withdrawn. It is kept, with its reason.</div><% } %>

<div class="note" style="margin-bottom:16px">
  A call the lobby <b>withdraws</b>, and a man the lobby <b>substitutes</b>, are both changes with a reason —
  not edits. The original is kept either way, because a substitution that quietly overwrites a name erases
  the only evidence of what the running room was originally asked to do. That is the same failure as deleting
  a withdrawn call, and it is why neither can be done on the sheet itself.
</div>

<div class="card" style="margin-bottom:16px">
  <div class="card-h"><h3>Calls on <%= date %></h3>
    <span class="sub">pick the row you need to change</span></div>
  <div class="tblwrap"><table class="tbl">
    <thead><tr><th style="width:74px">Rang at</th><th style="width:130px">Train</th><th>Crew</th>
      <th style="width:150px">Status</th><th style="width:230px">Change it</th></tr></thead>
    <tbody>
    <% calls.forEach(function(c){ %>
      <tr<%= c.cancelled_at ? ' style="opacity:.55"' : '' %>>
        <td class="tnum"><a href="<%= url('/records/call-book/' + c.id) %>"><%=
          c.call_received_at ? String(c.call_received_at).slice(11,16) : '—' %></a></td>
        <td class="tnum"><%= c.train_no || '—' %>
          <% if (c.train_name) { %><div class="muted" style="font-size:10.5px"><%= c.train_name %></div><% } %></td>
        <td>
          <% c.lines.forEach(function(l){ %>
            <div style="font-size:12.5px">
              <%= l.crew_name %>
              <% if (l.crew_role) { %><span class="pill" style="font-size:9px"><%= l.crew_role %></span><% } %>
              <% if (l.ack_outcome === 'acknowledged') { %>
                <span class="st good" style="font-size:9.5px"><span class="dot"></span>ack</span><% } %>
            </div>
          <% }); %>
          <% if (!c.lines.length) { %><span class="muted">nobody booked</span><% } %>
        </td>
        <td>
          <% if (c.cancelled_at) { %><span class="st"><span class="dot"></span>Withdrawn</span>
            <div class="muted" style="font-size:10.5px"><%= c.cancelled_reason %></div>
          <% } else if (c.open) { %><span class="st warn"><span class="dot"></span><%= c.open %> not settled</span>
          <% } else if (c.bad.length) { %><span class="st crit"><span class="dot"></span><%= c.bad.length %> not acknowledged</span>
          <% } else { %><span class="st good"><span class="dot"></span>All acknowledged</span><% } %>
        </td>
        <td>
          <% if (can('stay.manage') && !c.cancelled_at) { %>
            <details>
              <summary class="muted" style="font-size:11.5px;cursor:pointer">The lobby withdrew this call</summary>
              <form method="post" action="<%= url('/records/call-book/' + c.id + '/withdraw') %>" style="margin-top:8px">
                <input class="fi" name="reason" maxlength="200" required placeholder="why — train cancelled, called in error"
                       style="font-size:12px;padding:5px 7px;margin-bottom:6px">
                <input class="fi" name="advised_by" maxlength="120" placeholder="who at the lobby said so"
                       style="font-size:12px;padding:5px 7px;margin-bottom:6px">
                <button class="btn warn" type="submit" style="font-size:11.5px">Mark it withdrawn</button>
              </form>
            </details>
            <% if (c.lines.length) { %>
            <details style="margin-top:6px">
              <summary class="muted" style="font-size:11.5px;cursor:pointer">The lobby changed a man</summary>
              <form method="post" action="<%= url('/records/call-book/' + c.id + '/change-crew') %>"
                    style="margin-top:8px" class="crewchange"
                    data-search="<%= hasMaster ? url('/records/crew-search') : '' %>" data-rr="<%= rr.id %>">
                <label class="fl" style="font-size:10.5px">Who was booked</label>
                <select class="fi" name="line" style="font-size:12px;padding:5px 7px;margin-bottom:6px">
                  <% c.lines.forEach(function(l){ %>
                    <option value="<%= l.id %>"><%= l.crew_role || '' %> — <%= l.crew_name %></option>
                  <% }); %>
                </select>
                <label class="fl" style="font-size:10.5px">Who is booked now</label>
                <input class="fi crewname" name="crew_name" list="crewlist" autocomplete="off" required
                       style="font-size:12px;padding:5px 7px;margin-bottom:6px" placeholder="name">
                <input type="hidden" name="crew_hrms" value="">
                <input class="fi" name="reason" maxlength="200" required placeholder="the reason the lobby gave"
                       style="font-size:12px;padding:5px 7px;margin-bottom:6px">
                <input class="fi" name="advised_by" maxlength="120" placeholder="who at the lobby said so"
                       style="font-size:12px;padding:5px 7px;margin-bottom:6px">
                <button class="btn" type="submit" style="font-size:11.5px">Record the change</button>
                <div class="muted" style="font-size:10.5px;margin-top:6px">
                  The new man has not acknowledged anything, so the call reopens and the lobby has to be told
                  again. Leaving the old man's acknowledgement attached to a new name would be a false record.
                </div>
              </form>
            </details>
            <% } %>
          <% } else if (!can('stay.manage')) { %>
            <span class="muted" style="font-size:11.5px">view only</span>
          <% } %>
        </td>
      </tr>
    <% }); %>
    <% if (!calls.length) { %><tr><td colspan="5" class="muted">No call was taken on this date.</td></tr><% } %>
    </tbody>
  </table></div>
  <div id="crewlines" data-search="<%= hasMaster ? url('/records/crew-search') : '' %>"
       data-rr="<%= rr.id %>" hidden></div>
  <datalist id="crewlist"></datalist>
</div>

<div class="card">
  <div class="card-h"><h3>What has been changed</h3>
    <span class="sub">kept, so a substitution can be read back months later</span></div>
  <div class="tblwrap"><table class="tbl">
    <thead><tr><th style="width:130px">When</th><th style="width:120px">What</th><th>Was</th><th>Now</th>
      <th>Reason</th><th style="width:140px">Lobby</th><th style="width:110px">By</th></tr></thead>
    <tbody>
    <% history.forEach(function(h){ %>
      <tr>
        <td class="tnum"><%= String(h.changed_at).slice(0,16).replace('T',' ') %></td>
        <td><%= h.change_type === 'withdrawn' ? 'Call withdrawn'
              : h.change_type === 'crew_changed' ? 'Crew changed'
              : h.change_type === 'crew_added' ? 'Crew added' : 'Crew removed' %></td>
        <td><%= h.was_crew_name || '—' %></td>
        <td><%= h.now_crew_name || '—' %></td>
        <td style="font-size:12px"><%= h.reason %></td>
        <td style="font-size:12px"><%= h.advised_by || '—' %></td>
        <td style="font-size:12px"><%= h.by_name || '—' %></td>
      </tr>
    <% }); %>
    <% if (!history.length) { %>
      <tr><td colspan="7" class="muted">Nothing has been withdrawn or changed on this date.</td></tr><% } %>
    </tbody>
  </table></div>
</div>
