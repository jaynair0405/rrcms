<div style="margin-bottom:14px"><a href="<%= url('/inspections') %>">← Inspection log</a></div>

<div class="card" style="margin-bottom:14px"><div class="card-b">
  <div class="row" style="align-items:flex-start">
    <div style="flex:1">
      <div style="font-size:20px;font-weight:680;letter-spacing:-.4px">
        <%= insp.inspection_type.replace('_',' ').replace(/^\w/, c => c.toUpperCase()) %> report — <%= insp.rr_name %><%
          if (insp.block_name) { %>, <%= insp.block_name %><% } %>
      </div>
      <div class="muted" style="font-size:12.5px;margin-top:2px">
        <%= insp.inspection_date %> · <%= insp.div_name %> Division (<%= insp.div_code %>)
        <%# WHERE IT WAS WALKED. A finding with no place cannot be answered by
            the contractor or verified afterwards, so the report says which
            building — or says plainly that it covered the whole site, rather
            than leaving the reader to assume. %>
        <% if (insp.block_name) { %> · <b><%= insp.block_name %></b><%
          if (!insp.block_live) { %> <span class="st warn" style="font-size:11px"><span class="dot"></span>no longer on the register</span><% } %>
        <% } %>
      </div>
    </div>
    <div style="text-align:right">
      <% if (insp.result === 'compliant') { %><span class="st good" style="font-size:13px"><span class="dot"></span>Fully compliant</span>
      <% } else if (insp.result === 'minor_deficiencies') { %><span class="st warn" style="font-size:13px"><span class="dot"></span>Minor deficiencies</span>
      <% } else { %><span class="st crit" style="font-size:13px"><span class="dot"></span>Major deficiencies</span><% } %>
      <div class="muted" style="font-size:11.5px;margin-top:3px"><%= insp.deficiency_count %> of <%= insp.items_checked %> items</div>
    </div>
  </div>
  <div class="hr"></div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;font-size:12.5px">
    <div><div class="muted" style="font-size:10.5px">INSPECTED BY (RAILWAY)</div><b><%= insp.inspector_name || '—' %></b></div>
    <div><div class="muted" style="font-size:10.5px">CONTRACTOR'S REPRESENTATIVE</div><b><%= insp.contractor_rep_name || 'nobody was present' %></b></div>
    <div><div class="muted" style="font-size:10.5px">SUBMITTED</div><b class="tnum"><%= insp.submitted_at ? String(insp.submitted_at).slice(0,16) : '—' %></b></div>
    <div><div class="muted" style="font-size:10.5px">RAILWAY SIGNATURE</div>
      <b><% if (insp.railway_sign_file_id !== null) { %><span class="st good"><span class="dot"></span>Signed</span>
         <% } else { %><span class="st warn"><span class="dot"></span>Awaiting</span><% } %></b></div>
  </div>
  <% if (insp.remarks) { %>
    <div class="hr"></div>
    <div class="muted" style="font-size:10.5px">REMARKS</div>
    <div style="font-size:12.5px;white-space:pre-line"><%= insp.remarks %></div>
  <% } %>
  <% if (insp.railway_sign_file_id === null && can('inspection.sign')) { %>
    <div class="hr"></div>
    <form method="post" action="<%= url('/inspections/' + insp.id + '/sign') %>">
      <button class="btn" type="submit">Sign as Railway representative</button>
      <span class="muted" style="font-size:11.5px;margin-left:10px">Your name and today's date are added to the record.</span>
    </form>
  <% } %>
</div></div>

<% if (fails.length) { %>
<div class="card" style="margin-bottom:14px">
  <div class="card-h"><h3>Deficiencies recorded</h3>
    <span class="sub">raised against their clauses — no amount computed</span></div>
  <div class="tblwrap"><table class="tbl">
    <thead><tr><th>Clause</th><th>Nature</th><th class="num">Qty</th><th>Observation</th><th>Evidence</th></tr></thead>
    <tbody>
    <% fails.forEach(function(i){ %>
      <tr>
        <td><span class="pill r"><%= i.clause_code %></span></td>
        <td style="font-size:12.2px"><%= i.description %></td>
        <td class="num"><%= i.quantity %></td>
        <td style="font-size:11.8px"><%= i.observation || '—' %></td>
        <td><% if (i.evidence_file_id) { %>
              <a href="<%= url('/photo/' + i.evidence_file_id) %>" target="_blank">
                <img src="<%= url('/photo/' + i.evidence_file_id) %>" alt="evidence"
                     style="height:52px;border-radius:6px;border:1px solid var(--border)"></a>
            <% } else { %><span class="muted">—</span><% } %></td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
</div>
<% } %>

<div class="card">
  <div class="card-h"><h3>Full checklist</h3><span class="sub"><%= items.length %> items checked</span></div>
  <div class="tblwrap"><table class="tbl">
    <thead><tr><th style="width:70px">Clause</th><th>Head</th><th>Nature of deficiency / irregularity</th>
      <th>Position</th><th>Observation</th></tr></thead>
    <tbody>
    <% items.forEach(function(i){ %>
      <tr <%= i.status === 'not_complied' ? 'style="background:rgba(208,59,59,.04)"' : '' %>>
        <td><span class="pill <%= i.status === 'not_complied' ? 'r' : 'b' %>"><%= i.clause_code %></span></td>
        <td class="muted" style="font-size:11.5px"><%= i.group_name %></td>
        <td style="font-size:12.2px"><%= i.description %></td>
        <td><% if (i.status === 'complied') { %><span class="st good"><span class="dot"></span>Complied</span>
            <% } else if (i.status === 'not_complied') { %><span class="st crit"><span class="dot"></span>Not complied</span>
            <% } else { %><span class="muted">Not applicable</span><% } %></td>
        <td style="font-size:11.8px"><%= i.observation || '—' %></td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
</div>
