<div class="note" style="margin-bottom:14px">
  This is the tender's <b>daily joint compliance checklist</b>. The Railway representative and the contractor's
  supervisor go through it together, once a day. Every <b>Not complied</b> becomes a recorded deficiency against
  its clause, with a photo if you attach one. <b>No amount is calculated</b> — that is switched on when the
  penalty schedule under review is settled.
</div>

<form method="post" action="<%= url('/inspections/new') %>" enctype="multipart/form-data">
  <div class="card" style="margin-bottom:14px"><div class="card-b">
    <div class="row" style="gap:12px;align-items:flex-end">
      <div style="flex:0 0 240px"><label class="fl">Running room</label>
        <select class="fi" name="rr" onchange="location.href='<%= url('/inspections/new') %>?rr='+this.value+'&date=<%= date %>&type=<%= type %>'">
          <% rooms.forEach(function(r){ %><option value="<%= r.id %>" <%= r.id===rr.id?'selected':'' %>><%= r.name %> (<%= r.div_code %>)</option><% }); %>
        </select></div>
      <div style="flex:0 0 160px"><label class="fl">Date</label>
        <input class="fi" type="date" name="date" value="<%= date %>"
               <% if (typeof maxDate !== 'undefined') { %>max="<%= maxDate %>"<% } %>
               onchange="location.href='<%= url('/inspections/new') %>?rr=<%= rr.id %>&date='+this.value+'&type=<%= type %>&block=<%= blockId || '' %>'"></div>
      <div style="flex:0 0 190px"><label class="fl">Type</label>
        <select class="fi" name="type">
          <% [['daily_joint','Daily joint'],['scheduled','Scheduled'],['surprise','Surprise'],['higher_official','Higher official']]
              .forEach(function(t){ %><option value="<%= t[0] %>" <%= type===t[0]?'selected':'' %>><%= t[1] %></option><% }); %>
        </select></div>
      <%# WHICH BUILDING — OFFERED, NOT DEMANDED.
          An inspection may genuinely cover the whole of Igatpuri, and requiring
          a building would make the inspector pick one falsely to get past the
          form. A false place on a finding is worse than none: it sends the
          contractor to answer for a bathroom nobody looked at. %>
      <% if (blocks && blocks.length) { %>
        <div style="flex:0 0 210px"><label class="fl">Which building</label>
          <%# Changing the building RELOADS, so the "already filed today" check
              is applied to the building actually being walked. Without the
              reload the form would open on a report already written for a
              different building. %>
          <select class="fi" name="block"
                  onchange="location.href='<%= url('/inspections/new') %>?rr=<%= rr.id %>&date=<%= date %>&type=<%= type %>&block='+this.value">
            <option value="">— all of <%= rr.name %> —</option>
            <% blocks.forEach(function(b){ %>
              <option value="<%= b.id %>" <%= blockId === b.id ? 'selected' : '' %>><%= b.name %></option>
            <% }); %>
          </select></div>
      <% } %>
      <%# THE CONTRACTOR NEED NOT BE THERE, and the form must not pretend he
          is. The CLI inspects at any hour; the contractor's supervisor works
          the day shift only. Requiring a name made a two o'clock inspection
          impossible to file at all -- and an inspection that cannot be filed
          is an inspection that did not happen, as far as any record goes.

          Nobody present is itself a fact worth keeping, and a different fact
          from a blank box: a contractor with no man available at night is not
          the same as an inspector who forgot to type a name. So one of the two
          must be given, and the report says which. %>
      <%# Not offered once a report for this walk is already filed. Nothing on
          this page can be submitted then, and an empty name box beside a notice
          saying the work is done reads as an invitation to fill it in. It also
          left the panel half blank, because this block is the tall one the
          selectors align against. %>
      <% if (!(typeof filed !== 'undefined' && filed)) { %>
      <div style="flex:1"><label class="fl">Contractor&rsquo;s representative present
        <span class="muted" style="font-weight:400">(leave blank if nobody was)</span></label>
        <input class="fi" name="contractor_rep_name" placeholder="Name of the supervisor present">
        <label style="display:flex;gap:7px;align-items:flex-start;margin-top:7px;cursor:pointer">
          <input type="checkbox" name="unaccompanied" value="1" style="margin-top:3px">
          <span class="muted" style="font-size:11.5px">Nobody from the contractor was present.
            Tick this and the report says so — it does not leave the question unanswered.</span>
        </label></div>
      <% } %>
    </div>
    <% if (blocks && blocks.length) { %>
      <div class="muted" style="font-size:11.5px;margin-top:8px">
        <%= rr.name %> stands in <%= blocks.length %> buildings. Naming the one you walked puts the
        finding where it happened, so the contractor can answer it and somebody can go back and
        look. Leave it as all of <%= rr.name %> only where the check really did cover the site.
      </div>
    <% } %>
    <%# The page was ASKED for a date ahead of today and quietly showed a
        different one. Saying so beats letting somebody wonder why the date box
        keeps changing under them. %>
    <% if (typeof future !== 'undefined' && future) { %>
      <div class="note warn" style="margin-top:12px"><b><%= future %> has not happened yet.</b>
        An inspection is filed for the day it was walked, so this has opened on
        <b><%= date %></b> instead.</div>
    <% } %>
    <% if (!rr.has_meal_facility) { %>
      <div class="note warn" style="margin-top:12px"><b><%= rr.name %> has no meal facility</b>, so the kitchen and
      food clauses are not shown — they cannot apply here.</div>
    <% } %>
  </div></div>

  <% if (typeof filed !== 'undefined' && filed) { %>
    <%# ALREADY FILED. This used to redirect straight to the report and say
        nothing, so an officer coming back for a second inspection landed on the
        finished one with no explanation — and concluded the form had no date
        selector, which it has, three boxes above this. The selectors stay on
        the page so the way out is visible: change the building, the type, or
        the date. The checklist is left off deliberately: the database will
        refuse a second report for the same walk, and a form that cannot be
        submitted should not be offered. %>
    <div class="note warn">
      <b>A <%= type.replace('_',' ') %> report for <%= rr.name %><% if (blockId && blocks) {
        const b = blocks.find(function(x){ return x.id === blockId; }); if (b) { %> — <%= b.name %><% } } %>
      on <%= date %> is already filed.</b>
      <div style="margin-top:6px">
        Filed by <%= filed.inspector_name %><% if (filed.submitted_at) { %> at
        <%= String(filed.submitted_at).slice(11,16) %><% } %>,
        <%= filed.items_checked %> items checked,
        <%= filed.deficiency_count %> deficienc<%= filed.deficiency_count === 1 ? 'y' : 'ies' %> recorded.
      </div>
      <div style="margin-top:10px">
        <a class="btn small" href="<%= url('/inspections/' + filed.id) %>">Open that report</a>
        <span class="muted" style="font-size:11.5px;margin-left:10px">To file another, change the
          building, the type or the date above.</span>
      </div>
    </div>
  <% } else { %>
  <% let lastGroup = null; %>
  <div class="card"><div class="tblwrap"><table class="tbl">
    <thead><tr><th style="width:70px">Clause</th><th>Nature of deficiency / irregularity</th>
      <th style="width:230px">Position</th><th style="width:80px" class="num">Qty</th>
      <th style="width:200px">Observation</th><th style="width:150px">Photo</th></tr></thead>
    <tbody>
    <% clauses.forEach(function(c){
         const newGroup = c.group_name !== lastGroup; lastGroup = c.group_name; %>
      <% if (newGroup) { %>
        <tr style="background:var(--plane)"><td colspan="6"><b style="font-size:11.5px;letter-spacing:.4px;text-transform:uppercase"><%= c.group_name %></b></td></tr>
      <% } %>
      <tr>
        <td><span class="pill b"><%= c.clause_code %></span></td>
        <td style="font-size:12.3px"><%= c.description %>
          <div class="muted" style="font-size:10.5px"><%= c.unit %></div></td>
        <td>
          <select class="fi" name="c_<%= c.id %>" style="padding:5px 8px;font-size:12px">
            <option value="complied">Complied</option>
            <option value="not_complied">Not complied</option>
            <option value="not_applicable">Not applicable</option>
          </select>
        </td>
        <td class="num"><input class="fi" type="number" min="0" name="q_<%= c.id %>" value="0"
          style="width:64px;padding:5px 7px;text-align:right"></td>
        <td><input class="fi" name="o_<%= c.id %>" placeholder="what was seen" style="padding:5px 8px;font-size:12px"></td>
        <td><%# NO capture ATTRIBUTE, and it was removed rather than never added.
            capture="environment" opens the rear camera straight away on a phone --
            and hides the gallery while doing it. Ruled by the officer on
            10.09.2026: the supervisor and the RR in-charge must have BOTH. He
            works the day shift and fills the register for rounds he walked
            earlier, so the photograph he needs is often already on the phone.
            accept="image/*" alone gives a phone the choice: Camera, Photos,
            Files. %>
        <input class="fi" type="file" name="p_<%= c.id %>" accept="image/*"
          style="padding:4px;font-size:11px"></td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
    <div class="card-b" style="border-top:1px solid var(--border)">
      <label class="fl">General remarks</label>
      <textarea class="fi" name="remarks" rows="2" placeholder="Anything not covered by a clause above"></textarea>
      <div class="row" style="margin-top:12px;gap:10px;align-items:center">
        <button class="btn" type="submit">Submit joint report</button>
        <span class="muted" style="font-size:11.5px">Once submitted the report is a record; deficiencies are raised
        against their clauses and appear in the deficiency register.</span>
      </div>
    </div>
  </div>
  <% } %>
</form>
