<div class="note warn" style="margin-bottom:16px">
  <b>These are the rows the penalty engine will read.</b> Each one carries the clause, the date, a quantity and
  whatever evidence was attached. <b>No amount is computed anywhere</b> — the clause rate is shown only as
  reference. When the penalty schedule under review is finalised, the calculation runs over exactly this register,
  so nothing needs re-entering.
</div>

<div class="kpis" style="margin-bottom:16px">
  <div class="kpi"><i class="strip" style="background:var(--s8)"></i>
    <div class="lab">Deficiencies recorded</div><div class="val"><%= fmtInt(counts.total || 0) %></div>
    <div class="foot">across <%= counts.sites || 0 %> running rooms</div></div>
  <div class="kpi"><i class="strip" style="background:var(--s2)"></i>
    <div class="lab">Still open</div><div class="val"><%= fmtInt(counts.open || 0) %></div>
    <div class="foot"><span class="st <%= (counts.open||0) ? 'warn':'good' %>"><span class="dot"></span>awaiting rectification</span></div></div>
  <div class="kpi"><i class="strip" style="background:var(--s3)"></i>
    <div class="lab">Rectified</div><div class="val"><%= fmtInt(counts.rectified || 0) %></div>
    <div class="foot">closed with remarks</div></div>
  <% (byGroup || []).slice(0,2).forEach(function(g){ %>
  <div class="kpi"><i class="strip" style="background:var(--s4)"></i>
    <div class="lab"><%= g.group_name %></div><div class="val"><%= g.n %></div>
    <div class="foot">most frequent head</div></div>
  <% }); %>
</div>

<form class="row" method="get" style="margin-bottom:14px">
  <select class="fi" name="rr" style="max-width:200px"><option value="">All running rooms</option>
    <% rooms.forEach(function(r){ %><option value="<%= r.id %>" <%= String(rr)===String(r.id)?'selected':'' %>><%= r.name %></option><% }); %>
  </select>
  <select class="fi" name="status" style="max-width:150px"><option value="">Any status</option>
    <% ['open','rectified','closed','withdrawn'].forEach(function(s){ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }); %>
  </select>
  <select class="fi" name="group" style="max-width:230px"><option value="">Any head</option>
    <% (byGroup||[]).forEach(function(g){ %><option value="<%= g.group_code %>" <%= group===g.group_code?'selected':'' %>><%= g.group_name %></option><% }); %>
  </select>
  <div style="flex:0 0 150px"><input class="fi" type="date" name="from" value="<%= from %>" title="From"></div>
  <div style="flex:0 0 150px"><input class="fi" type="date" name="to" value="<%= to %>" title="To"></div>
  <button class="btn" type="submit">Filter</button>
  <div class="spacer"></div><span class="muted" style="font-size:12px"><%= rows.length %> shown</span>
</form>

<% if (can('deficiency.record')) { %>
  <div class="row" style="gap:8px;margin-bottom:14px">
    <a class="btn" href="<%= url('/deficiencies/review') %>?period=monthly">Monthly review</a>
    <a class="btn ghost" href="<%= url('/deficiencies/review') %>?period=weekly">Weekly review</a>
    <div class="spacer"></div>
    <div class="muted" style="font-size:11.5px;align-self:center">
      The daily joint report covers the daily clauses. These cover the rest — garden, uniforms, wages,
      water and electricity, the complaint book, fire extinguishers.
    </div>
  </div>
<% } %>
<div class="card"><div class="tblwrap"><table class="tbl">
  <thead><tr><th>Date</th><th>Running room</th><th>Clause</th><th>Nature of deficiency</th>
    <th class="num">Qty</th><th class="num">Rate (ref.)</th><th>Source</th><th>Evidence</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(function(d){ %>
    <tr id="d<%= d.id %>"<%- d.id === highlight ? ' style="background:rgba(214,140,42,.13)"' : '' %>>
      <td class="tnum"><%= d.occurred_on %></td>
      <td><a href="<%= url('/running-rooms/' + d.rr_id) %>"><%= d.rr_name %></a>
        <span class="muted" style="font-size:10.5px"><%= d.div_code %></span></td>
      <td><span class="pill <%= d.status === 'open' ? 'r' : 'b' %>"><%= d.clause_code %></span></td>
      <td style="font-size:12.2px"><%= d.clause_description %>
        <% if (d.description && d.description !== d.clause_description) { %>
          <div style="font-size:11.5px;margin-top:3px;color:var(--text-secondary)">
            <b>Observed:</b> <%= d.description %></div>
        <% } %>
        <% if (d.closure_remarks) { %>
          <div class="muted" style="font-size:11px;margin-top:2px">Rectified: <%= d.closure_remarks %></div>
        <% } %></td>
      <td class="num"><%= d.quantity %></td>
      <td class="num muted"><%= d.rate === null ? '—' : fmtInt(d.rate) %></td>
      <td class="muted" style="font-size:11.5px"><%= d.source.replace('_',' ') %></td>
      <td><% if (d.evidence_file_id) { %>
            <a href="<%= url('/photo/' + d.evidence_file_id) %>" target="_blank">
              <img src="<%= url('/photo/' + d.evidence_file_id) %>" alt="evidence"
                   style="height:38px;border-radius:5px;border:1px solid var(--border)"></a>
          <% } else { %><span class="muted">—</span><% } %></td>
      <td><% if (d.status === 'open') { %><span class="st warn"><span class="dot"></span>Open</span>
          <% } else { %><span class="st good"><span class="dot"></span><%= d.status %></span><% } %></td>
      <td><% if (d.status === 'open' && can('deficiency.close')) { %>
            <form method="post" action="<%= url('/deficiencies/' + d.id + '/close') %>" class="row" style="gap:5px">
              <input class="fi" name="closure_remarks" placeholder="Action taken" required
                     style="width:140px;padding:4px 7px;font-size:12px">
              <button class="btn small" type="submit">Rectified</button>
            </form>
          <% } %></td>
    </tr>
  <% }); %>
  <% if (!rows.length) { %><tr><td colspan="10" class="muted">No deficiencies match.</td></tr><% } %>
  </tbody>
</table></div></div>
