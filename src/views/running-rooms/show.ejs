<div style="margin-bottom:14px"><a href="<%= url('/running-rooms') %>">← All running rooms</a></div>

<div class="card" style="margin-bottom:14px"><div class="card-b">
  <div style="font-size:22px;font-weight:680;letter-spacing:-.5px"><%= rr.name %> Running Room</div>
  <div class="muted" style="font-size:12.5px;margin-top:2px">
    <%= rr.code %> · <%= rr.div_name %> Division (<%= rr.div_code %>) · Category <%= rr.category %> · under <%= rr.control_dept %>
  </div>
  <div class="hr"></div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px 18px;font-size:12.5px">
    <div><div class="muted" style="font-size:10.5px">ROOMS / BEDS</div><b class="tnum"><%= rr.physical_rooms %> / <%= rr.total_beds %></b></div>
    <div><div class="muted" style="font-size:10.5px">CREWS PER DAY</div><b class="tnum"><%= fmtInt(rr.ref_crews_per_day) %>
      <span class="muted" style="font-weight:400">(<%= rr.total_beds ? (rr.ref_crews_per_day/rr.total_beds).toFixed(2) : '—' %>× turnover)</span></b></div>
    <div><div class="muted" style="font-size:10.5px">PEAK CONCURRENT</div><b class="tnum"><%= fmtInt(rr.ref_peak_occupancy) %>
      <span class="muted" style="font-weight:400">(<%= rr.total_beds ? Math.round(rr.ref_peak_occupancy/rr.total_beds*100) : 0 %>%)</span></b></div>
    <div><div class="muted" style="font-size:10.5px">FEMALE ROOMS</div><b><% if (rr.female_rooms) { %><%= rr.female_rooms %> reserved<% } else { %><span class="st warn"><span class="dot"></span>None</span><% } %></b></div>
    <div><div class="muted" style="font-size:10.5px">MEAL FACILITY</div><b><%= rr.has_meal_facility ? 'Subsidised meals (RRMS)' : 'Not provided' %></b></div>
    <div><div class="muted" style="font-size:10.5px">AIR CONDITIONING</div><b><%= rr.ac_status === 'working' ? 'Working' : rr.ac_status.replace('_',' ') %><%= rr.ac_remarks ? ' — ' + rr.ac_remarks : '' %></b></div>
    <% if (contract) { %>
    <div><div class="muted" style="font-size:10.5px">CONTRACTOR</div><b><%= contract.contractor %></b></div>
    <div><div class="muted" style="font-size:10.5px">AGREEMENT</div><b class="tnum"><%= contract.agreement_no %></b></div>
    <div><div class="muted" style="font-size:10.5px">VALID UPTO</div><b><%= contract.end_date %></b></div>
    <% } %>
  </div>
</div></div>

<div class="grid" style="grid-template-columns:1.2fr 1fr;margin-bottom:14px">
  <div class="card">
<% const fromContract = manpower.filter(m => m.is_overridden && m.sanctioned_count > 0); %>
    <div class="card-h"><h3>Manpower deployment</h3>
      <span class="sub">Schedule-A · <%= manpower.length ? manpower[0].band_beds : '—' %>-bed table<%
        if (manpower.length && manpower[0].is_scaled) { %> · scaled to <%= rr.total_beds %> beds<% }
        if (!rr.has_meal_facility) { %> · no kitchen crew<% } %></span>
      <% if (fromContract.length) { %>
        <span class="spacer"></span>
        <span class="st good"><span class="dot"></span>Establishment set by the contract</span>
      <% } %></div>
    <% if (fromContract.length) { %>
      <div class="card-b" style="padding-bottom:0">
        <div class="note">
          <b>This running room's own contract has been read in, so the contract is the establishment.</b>
          <b>Tender figure</b> is what Schedule-A works out for a running room of this size — what RR-CMS
          shows where nobody has yet read that room's contract. <b>This contract</b> is what the agreement
          actually bought, and it is the only column that counts here: it is what the Railway is paying
          for, so it is what a shortfall is measured against. The tender figure stays on the screen so
          anyone can see what changed and by how much.
        </div>
      </div>
    <% } %>
    <div class="tblwrap"><table class="tbl">
      <%# Column headings in the words the running room uses. "Norm", "Sanctioned"
          and "bed band" were all mine, not the tender's, and an RR In-charge had
          to ask what two of them meant. Say where each figure comes from instead
          of naming the mechanism that produced it. %>
      <thead><tr><th>Designation</th><th>Skill</th>
        <th class="num">Tender figure<div class="muted" style="font-weight:400;font-size:10px">for a room this size</div></th>
        <th class="num">This contract<div class="muted" style="font-weight:400;font-size:10px">what counts</div></th>
        <th class="num">On roll</th><th>Position</th></tr></thead>
      <tbody>
      <% manpower.filter(m => m.sanctioned_count > 0).forEach(function(m){ %>
        <tr>
          <td><%= m.name %>
            <% if (m.is_overridden && m.override_reason) { %>
              <div class="muted" style="font-size:10.5px"><%= m.override_reason %></div>
            <% } %></td>
          <td><span class="pill"><%= m.skill_category.replace('_','-') %></span></td>
          <td class="num muted"><%= m.norm_count %><% if (m.is_overridden) { %>
            <%# "superseded" was the first word here and an RR In-charge asked
                what it meant, which is the answer. A screen read by the man on
                the site says what it means in the words he would use. %>
            <div class="muted" style="font-size:10px">not used</div><% } %></td>
          <td class="num"><b><%= m.sanctioned_count %></b>
            <% if (m.is_overridden) { %>
              <div class="st good" style="font-size:10px"><span class="dot"></span>from the contract</div>
            <% } %></td>
          <%# THE NUMBER IS THE WAY IN.
              An officer reading "15 on roll" wants to know WHICH fifteen, and
              until now the only way was to leave the page, find Contract Staff,
              and filter it back down to the running room and the designation he
              was already looking at. Three navigations to answer a question the
              figure itself provokes. The figure is the link. %>
          <td class="num"><% if (m.on_roll) { %>
              <a href="<%= url('/staff') %>?rr=<%= rr.id %>&designation=<%= m.designation_id %>"
                 title="Who these <%= m.on_roll %> are"><%= m.on_roll %></a>
            <% } else { %><span class="muted">0</span><% } %></td>
          <td><% if (m.on_roll >= m.sanctioned_count) { %><span class="st good"><span class="dot"></span>Full</span>
              <% } else { %>
                <a href="<%= url('/staff') %>?rr=<%= rr.id %>&designation=<%= m.designation_id %>"
                   style="text-decoration:none"><span class="st crit"><span class="dot"></span>Short by <%= m.sanctioned_count - m.on_roll %></span></a>
              <% } %></td>
        </tr>
      <% }); %>
      <%# ONE total row.
          There were three: "bought by this contract 107", "not bought by this
          contract 21", and "total 128". Stacked, they were read as one number,
          and the 21 sat in the column headed "This contract" -- a figure for
          posts the contract does not buy, printed under a heading saying it
          does. The contract's own figure is now in the card heading where it is
          read first, and the split is spelt out in words below the table. %>
      <tr style="background:var(--plane)"><td colspan="3"><b>Total</b></td>
        <td class="num"><b><%= sanctioned %></b></td>
        <td class="num"><b><% if (onRoll) { %><a href="<%= url('/staff') %>?rr=<%= rr.id %>"
              title="Everyone on the roll at <%= rr.name %>"><%= onRoll %></a><% } else { %>0<% } %></b></td>
        <td><% if (onRoll >= sanctioned) { %><span class="st good"><span class="dot"></span>Full</span>
            <% } else { %><span class="st crit"><span class="dot"></span>Short by <%= sanctioned - onRoll %></span><% } %></td></tr>
      </tbody>
    </table></div>
    <%# A NOTE, NOT A FIGURE IN THE TABLE. These posts are on the tender's
        bed-band table and this contract does not buy them. They were once
        carried as sanctioned, which made the establishment total more than the
        contract bought. %>
    <% if (notBought.length) { %>
    <div class="card-b" style="border-top:1px solid var(--border)">
      <div class="note">
        <b>Not bought by this contract.</b>
        The tender's table for a running room this size also gives
        <%= notBought.map(function(r){ return r.name + ' ' + r.norm; }).join(', ') %>
        — <%= notBought.reduce(function(a, r){ return a + r.norm; }, 0) %> posts in all.
        <b>This contract buys none of them</b>, so they are not on the establishment above
        and no shortfall is raised against them.
      </div>
    </div>
    <% } %>
    <% if (manpower.length && manpower[0].is_scaled) { %>
    <div class="card-b" style="border-top:1px solid var(--border)">
      <div class="note"><b>Scaled below Schedule-A.</b> The matrix starts at 50 beds and this running room has
      <%= rr.total_beds %>, so the 50-bed row is applied pro-rata with a minimum per role. Supervisor and Call Boy
      keep a floor of 3 because they are round-the-clock posts — one per shift. The tender permits this:
      <i>"numbers are indicative … may increase/decrease depending upon the local conditions of running room."</i></div>
    </div>
    <% } %>
  </div>

  <div class="card">
    <div class="card-h"><h3>Occupancy &amp; feedback coverage</h3><span class="sub">occupant count comes from RRMS</span></div>
    <div class="tblwrap"><table class="tbl">
      <thead><tr><th>Month</th><th class="num">Occupants</th><th class="num">Feedback</th><th class="num">Coverage</th><th>50% floor</th></tr></thead>
      <tbody>
      <% coverage.forEach(function(c){ %>
        <tr><td class="tnum"><%= String(c.period_month).slice(0,7) %></td>
          <td class="num"><%= fmtInt(c.occupants_total) %></td>
          <td class="num"><%= fmtInt(c.feedback_received) %></td>
          <td class="num"><%= Number(c.coverage_pct).toFixed(1) %>%</td>
          <td><% if (c.meets_floor) { %><span class="st good"><span class="dot"></span>Met</span>
              <% } else { %><span class="st crit"><span class="dot"></span>Below — penalty not leviable</span><% } %></td></tr>
      <% }); %>
      <% if (!coverage.length) { %><tr><td colspan="5" class="muted">No occupancy figure entered yet.</td></tr><% } %>
      </tbody>
    </table></div>
    <% if (can('occupancy.record')) { %>
    <div class="card-b" style="border-top:1px solid var(--border)">
      <form method="post" action="<%= url('/running-rooms/' + rr.id + '/occupancy') %>" class="row" style="gap:10px;align-items:flex-end">
        <div style="flex:0 0 150px"><label class="fl" for="pm">Month</label>
          <input class="fi" id="pm" type="month" name="period_month" value="<%= thisMonth() %>" required></div>
        <div style="flex:0 0 170px"><label class="fl" for="ot">Occupants (from RRMS)</label>
          <input class="fi" id="ot" type="number" min="0" name="occupants_total" required></div>
        <button class="btn" type="submit">Save figure</button>
      </form>
      <div class="muted" style="font-size:11.5px;margin-top:8px">
        Read from the RRMS occupancy register. This is the denominator for the 50% floor; without it the grading
        penalty cannot be evaluated.
      </div>
    </div>
    <% } %>
  </div>
</div>

<div class="grid" style="grid-template-columns:1fr 1.3fr">
  <div class="card">
    <div class="card-h"><h3>Occupant grading</h3><span class="sub">R value per the tender's band table</span></div>
    <div class="tblwrap"><table class="tbl">
      <thead><tr><th>Month</th><th>Head</th><th class="num">Average</th><th class="num">Sample</th><th class="num">R</th><th>Coverage</th></tr></thead>
      <tbody>
      <% grading.forEach(function(g){ %>
        <tr><td class="tnum"><%= String(g.period_month).slice(0,7) %></td>
          <td style="text-transform:capitalize"><%= g.head %></td>
          <td class="num"><%= Number(g.avg_rating).toFixed(2) %></td>
          <td class="num"><%= g.sample_size %></td>
          <td class="num"><b><%= g.r_value %></b></td>
          <td><% if (g.coverage_met) { %><span class="st good"><span class="dot"></span>Met</span>
              <% } else { %><span class="st warn"><span class="dot"></span>Below floor</span><% } %></td></tr>
      <% }); %>
      <% if (!grading.length) { %><tr><td colspan="6" class="muted">No grading recorded yet.</td></tr><% } %>
      </tbody>
    </table></div>
  </div>
  <div class="card">
    <div class="card-h"><h3>Deficiencies recorded</h3><span class="sub">captured against clause — no amount computed</span></div>
    <div class="tblwrap"><table class="tbl">
      <thead><tr><th>Date</th><th>Clause</th><th>Deficiency</th><th class="num">Qty</th><th>Source</th><th>Status</th></tr></thead>
      <tbody>
      <% deficiencies.forEach(function(d){ %>
        <tr><td class="tnum"><%= d.occurred_on %></td>
          <td><span class="pill b"><%= d.clause_code %></span></td>
          <td style="font-size:11.8px"><%= d.description %></td>
          <td class="num"><%= d.quantity %></td>
          <td class="muted" style="font-size:11.5px"><%= d.source.replace('_',' ') %></td>
          <td><% if (d.status === 'open') { %><span class="st warn"><span class="dot"></span>Open</span>
              <% } else { %><span class="st good"><span class="dot"></span><%= d.status %></span><% } %></td></tr>
      <% }); %>
      <% if (!deficiencies.length) { %><tr><td colspan="6" class="muted">None recorded.</td></tr><% } %>
      </tbody>
    </table></div>
  </div>
</div>
