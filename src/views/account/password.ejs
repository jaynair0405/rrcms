<div class="grid" style="grid-template-columns:1fr 1fr;max-width:900px">
  <div class="card">
    <div class="card-h"><h3><%= forced ? 'Choose your own password' : 'Change your password' %></h3></div>
    <div class="card-b">
      <% if (done) { %>
        <div class="note ok" style="margin-bottom:14px">
          Your password has been changed. Any other session signed in as you has been ended.
        </div>
        <a class="btn" href="<%= url('/') %>">Carry on</a>
      <% } else { %>
        <% if (forced) { %>
          <div class="note" style="margin-bottom:14px">
            The password you signed in with was issued to you by an administrator, which means at least one
            other person has seen it. Until you choose your own, anything recorded under this account could
            have been recorded by either of you — so nothing else can be done until this is settled.
          </div>
        <% } %>
        <% if (error) { %><div class="note err" style="margin-bottom:14px"><%= error %></div><% } %>
        <form method="post" action="<%= url('/account/password') %>">
          <div style="margin-bottom:10px">
            <label class="fl">The password you signed in with</label>
            <input class="fi" type="password" name="current" autocomplete="current-password" required autofocus>
          </div>
          <div style="margin-bottom:10px">
            <label class="fl">Your new password</label>
            <input class="fi" type="password" name="fresh" autocomplete="new-password" minlength="6" required>
          </div>
          <div style="margin-bottom:14px">
            <label class="fl">The same again</label>
            <input class="fi" type="password" name="again" autocomplete="new-password" minlength="6" required>
          </div>
          <button class="btn" type="submit">Change it</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-h"><h3>What it has to be</h3></div>
    <div class="card-b">
      <ul style="font-size:12.5px;line-height:1.7;padding-left:18px;margin:0">
        <li><b>At least six characters.</b></li>
      </ul>
      <div class="hr"></div>
      <div class="muted" style="font-size:11.5px;line-height:1.6">
        There is no other rule. No capitals, no digits, no symbols required.
        <br><br>
        Nobody, including an administrator, can read your password back. If you forget it, an administrator
        issues a new one and you choose your own again on the next sign-in.
      </div>
    </div>
  </div>
</div>
